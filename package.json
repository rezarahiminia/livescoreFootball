    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongoose": "^6.2.5",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"

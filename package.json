{
  "name": "soccer-clubs-data-api",
  "version": "2.0.0",
  "description": "Free open-source football API for live scores, fixtures, results, standings and match events across the Premier League, LaLiga and more leagues.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "set NODE_ENV=development&& nodemon index.js",
    "prod": "set NODE_ENV=production&& node index.js",
    "start:dev": "cross-env NODE_ENV=development nodemon index.js",
    "start:prod": "cross-env NODE_ENV=production node index.js",
    "db:init-live": "node scripts/init-live-storage.js",
    "test:soccer": "node --test test/*.test.js"
  },
